<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:privy7.online</string>
		<string>applinks:app.privy7.online</string>
		<string>applinks:mobile.privy7.online</string>
		<string>applinks:auth.privy7.online</string>
		<string>webcredentials:auth.privy7.online</string>
		<string>webcredentials:*.privy7.online</string>
		<string>applinks:word.skin</string>
		<string>applinks:app.word.skin</string>
		<string>applinks:mobile.word.skin</string>
		<string>applinks:auth.word.skin</string>
		<string>applinks:matrix.to</string>
		<string>webcredentials:auth.word.skin</string>
		<string>webcredentials:*.word.skin</string>
	</array>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_IDENTIFIER)</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(KEYCHAIN_ACCESS_GROUP_IDENTIFIER)</string>
	</array>
</dict>
</plist>
